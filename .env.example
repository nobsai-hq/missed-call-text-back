# Copy to .env if you run local tests. Never commit real values.
# The n8n workflow itself does NOT read this file. Put Twilio login
# in the Send Text node as Basic Auth credentials inside n8n.

TWILIO_ACCOUNT_SID=YOUR_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN
TWILIO_FROM_NUMBER=+15555550100
BUSINESS_NAME=Sample Barber Shop
BOOKING_LINK=https://example.com/book
TIMEZONE=America/New_York
